# Template only. The real production file stays on the VPS: /etc/facelit/production.env.
DOMAIN=facelit.tech
SITE_ADDRESSES=facelit.tech
POSTGRES_DB=facelit-db
POSTGRES_USER=facelit_user
POSTGRES_PASSWORD=replace-with-private-production-password
JWT_SECRET=replace-with-private-signing-key-of-at-least-64-bytes
FACIAL_API_KEY=replace-with-private-internal-key
MAIL_USERNAME=sender@example.invalid
MAIL_PASSWORD=replace-with-private-gmail-app-password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
FACELIT_ALLOWED_ORIGINS=https://facelit.tech
